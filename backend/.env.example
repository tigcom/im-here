# ==============================================================================
# IM-HERE BACKEND (.env.example)
# Dùng cấu hình Render Environment Variables hoặc chạy Docker/Local
# ==============================================================================

# 1. Cổng lắng nghe (Render tự gán biến PORT ngẫu nhiên)
PORT=8080
SPRING_PROFILES_ACTIVE=production

# 2. Database PostgreSQL (Lấy từ Supabase Database / Neon / Aiven / Render Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password
HIBERNATE_DDL_AUTO=update

# 3. Redis (Lấy từ Upstash Redis: Host, Port, Password, SSL=true)
REDIS_HOST=apn1-xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_SSL=true

# 4. Supabase Storage - Private Buckets (Server-Side Service Role Key BẮT BUỘC)
# Lấy từ Supabase Console -> Project Settings -> API -> service_role key (secret)
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_KYC_BUCKET=imhere-kyc-private
SUPABASE_EVIDENCE_BUCKET=imhere-evidence-private
SUPABASE_SIGNED_URL_EXPIRES=900

# 5. JWT Authentication Secret (32 bytes hex ngẫu nhiên)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# 6. CORS Whitelist cho Frontend kết nối (Bắt buộc chỉ định domain production cụ thể)
# Không dùng wildcard rộng trên Production; điền URL Vercel chính thức của bạn
CORS_ALLOWED_ORIGINS=https://imhere.vercel.app,http://localhost:3000
