# ==============================================================================
# IM-HERE FRONTEND (.env.example)
# Dùng cho Vercel hoặc chạy Next.js cục bộ
# ==============================================================================

# URL API của Backend trên Render (Ví dụ: https://imhere-backend.onrender.com)
# Khi chạy local, để trống hoặc http://localhost:8080
NEXT_PUBLIC_API_URL=https://imhere-backend.onrender.com

# URL WebSocket STOMP (Tự sinh ra wss:// dựa theo API_URL nếu để trống)
NEXT_PUBLIC_WS_URL=wss://imhere-backend.onrender.com/api/ws
